# Robinhood Chain mainnet (chainId 4663, ETH gas). If your ISP filters this host, run
# `npm run rpc:proxy` in the launchpad repo and set http://127.0.0.1:8545 here instead.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Deploys the stack and owns it until OWNER takes over. Needs ~0.001 ETH on chain 4663.
DEPLOYER_PRIVATE_KEY=0x...

# The desk's session key: the only key that can call SessionKeyExecutor.execute. Make a fresh one
# with `cast wallet new`, fund it with a little ETH for gas, and never give it anything else.
AGENT_PRIVATE_KEY=0x...
AGENT=0x...            # its address; the deploy grants it a 30-day session (1,500 USDG/trade, 40 trades, 20k budget)

# Optional: hand ownership to a Safe at the end of the deploy (leave unset to keep the deployer as owner).
# OWNER=0x...
# Optional: deposit cap in whole USDG (default 10000).
# DEPOSIT_CAP_USDG=10000
